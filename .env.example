# Configuration precedence: command line > process environment > .env > defaults.
# Keep data outside the source directory if desired. No account data belongs here.
BASE_DIR=./data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
SAMPLE_RATE=2
CROP_RATIO=0.8
TOP_K=5
CONTEXT_SECONDS=3
MAX_HAMMING_DISTANCE=10
STRICT_GAP=1
MAX_SEGMENT_GAP=10
# HWACCEL=videotoolbox
ALGORITHM=sequence
EVIDENCE_MODE=hybrid
# Audio stream ordinals start at 0 among audio streams, not all media streams.
# SOURCE_AUDIO_STREAM=0
# TARGET_AUDIO_STREAM=0

# Experimental recovery; keep disabled until the real-film review gate passes.
COVERAGE_RECOVERY=false
# RECOVERY_STAGE=audio
